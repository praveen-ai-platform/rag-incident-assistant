# Explicit demo mode makes no AWS requests.
RAG_BACKEND=demo
ENVIRONMENT=development
API_KEY=
RAG_DATA_PATH=data/documents.json
# AWS mode uses a Knowledge Base configured with Titan embeddings + S3 Vectors.
AWS_REGION=us-east-1
BEDROCK_KNOWLEDGE_BASE_ID=
BEDROCK_DATA_SOURCE_ID=
BEDROCK_GENERATION_MODEL_ID=amazon.nova-lite-v1:0
RAG_SOURCE_BUCKET=
# Optional, read-only telemetry. Never use employer logs in a public demo.
CLOUDWATCH_LOG_GROUPS=
CLOUDWATCH_METRIC_NAMESPACE=
CLOUDWATCH_METRIC_NAME=
CLOUDWATCH_METRIC_DIMENSIONS=[]
